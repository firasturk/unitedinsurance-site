# ---- Supabase (Project Settings -> API) ----
# Public (build-time) values — safe for the browser
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable (anon) key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side values (Cloudflare: Settings -> Variables and Secrets, type = Secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable (anon) key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key — server only, never expose>

# ---- Anti-spam (Cloudflare Turnstile) ----
VITE_TURNSTILE_SITE_KEY=<public site key — safe for the browser>
TURNSTILE_SECRET_KEY=<secret key — Cloudflare Worker Secret only>

# ---- Email notifications (Resend) — all server-side Secrets ----
RESEND_API_KEY=<re_...>
NOTIFY_EMAIL=<inbox that receives form submissions, comma-separated for several>
NOTIFY_FROM=United Insurance <website@unitedjo.com>
